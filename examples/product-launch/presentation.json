        { "id": "before-3", "type": "text", "textRole": "lead", "x": 120, "y": 710, "w": 690, "h": 70, "text": "Trust the handoff", "fontSize": 24, "fontWeight": 400, "color": "1A1A1A" },
        { "id": "after-1", "type": "text", "textRole": "lead", "x": 1114, "y": 400, "w": 620, "h": 70, "text": "Retrieve the governed context", "fontSize": 24, "fontWeight": 500, "color": "1A1A1A" },
        { "id": "after-2", "type": "text", "textRole": "lead", "x": 1114, "y": 555, "w": 620, "h": 70, "text": "See why the state changed", "fontSize": 24, "fontWeight": 500, "color": "1A1A1A" },
        { "id": "after-3", "type": "text", "textRole": "lead", "x": 1114, "y": 710, "w": 620, "h": 70, "text": "Verify before the action", "fontSize": 24, "fontWeight": 500, "color": "1A1A1A" }
