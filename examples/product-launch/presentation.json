  "slides": [
    {
      "id": "opening",
      "title": "Work should remember why it exists",
      "layout": "cover-signal",
      "role": "cover",
      "intent": "Frame Dokki as the operating memory for agentic work.",
      "notes": "Open with the category promise. The red rule signals a state change, not decoration.",
      "elements": [
        { "id": "signal", "type": "shape", "shape": "rect", "x": 120, "y": 190, "w": 28, "h": 670, "fill": "F50132", "decorative": true },
        { "id": "kicker", "type": "text", "textRole": "label", "x": 190, "y": 176, "w": 700, "h": 40, "text": "DOKKI / AGENT OS", "fontSize": 16, "fontWeight": 600, "color": "F50132" },
        { "id": "title", "type": "text", "textRole": "display", "primary": true, "x": 190, "y": 245, "w": 1330, "h": 320, "text": "Work should remember\nwhy it exists.", "fontSize": 60, "fontWeight": 300, "lineHeight": 1.02, "color": "1A1A1A" },
        { "id": "subtitle", "type": "text", "textRole": "lead", "x": 196, "y": 640, "w": 1220, "h": 140, "text": "Turn intent into shared context, governed action, and verifiable outcomes.", "fontSize": 24, "fontWeight": 400, "lineHeight": 1.25, "color": "666666" },
        { "id": "format", "type": "text", "textRole": "meta", "x": 1320, "y": 830, "w": 480, "h": 44, "text": "ARTIFACT → EDITABLE PPTX", "fontSize": 14, "fontWeight": 600, "align": "right", "color": "666666" }
      ]
    },
    {
      "id": "thesis",
      "title": "The workspace becomes the memory",
      "layout": "statement",
      "role": "statement",
      "intent": "Make the distinction between file storage and operating memory memorable.",
      "notes": "Pause after the first line. The second line is the category distinction.",
      "elements": [
        { "id": "marker", "type": "shape", "shape": "rect", "x": 120, "y": 208, "w": 92, "h": 12, "fill": "F50132", "decorative": true },
        { "id": "statement", "type": "text", "textRole": "display", "primary": true, "x": 120, "y": 270, "w": 1550, "h": 390, "text": "Files store output.\nDokki preserves intent.", "fontSize": 56, "fontWeight": 300, "lineHeight": 1.05, "color": "1A1A1A" },
        { "id": "proof", "type": "text", "textRole": "lead", "x": 1114, "y": 720, "w": 686, "h": 200, "text": "Every decision keeps its context, owner, evidence, and next action.", "fontSize": 24, "fontWeight": 400, "lineHeight": 1.3, "color": "666666" }
      ]
    },
    {
      "id": "gap",
      "title": "Context breaks at every handoff",
      "layout": "split",
      "role": "content",
      "intent": "Show why disconnected tools make agentic work brittle.",
      "notes": "The left side states the problem. The right side names the three recurring fractures.",
      "elements": [
        { "id": "title", "type": "text", "textRole": "title", "primary": true, "x": 120, "y": 150, "w": 1400, "h": 86, "text": "Context breaks at every handoff", "fontSize": 35, "fontWeight": 500, "color": "1A1A1A" },
        { "id": "divider", "type": "shape", "shape": "rect", "x": 960, "y": 300, "w": 2, "h": 570, "fill": "D6D7D2", "decorative": true },
        { "id": "left-label", "type": "text", "textRole": "label", "x": 120, "y": 320, "w": 480, "h": 40, "text": "THE COST", "fontSize": 16, "fontWeight": 600, "color": "F50132" },
        { "id": "left-copy", "type": "text", "textRole": "display", "x": 120, "y": 390, "w": 690, "h": 360, "text": "Agents restart\nfrom fragments.", "fontSize": 50, "fontWeight": 300, "lineHeight": 1.05, "color": "1A1A1A" },
        { "id": "right-1-label", "type": "text", "textRole": "label", "x": 1114, "y": 320, "w": 230, "h": 34, "text": "01 / IDENTITY", "fontSize": 16, "fontWeight": 600, "color": "1A1A1A" },
        { "id": "right-1-copy", "type": "text", "textRole": "body", "x": 1114, "y": 366, "w": 610, "h": 92, "text": "The same person, project, or decision appears under different names.", "fontSize": 18, "fontWeight": 400, "lineHeight": 1.25, "color": "666666" },
        { "id": "right-2-label", "type": "text", "textRole": "label", "x": 1114, "y": 505, "w": 250, "h": 34, "text": "02 / TIME", "fontSize": 16, "fontWeight": 600, "color": "1A1A1A" },
        { "id": "right-2-copy", "type": "text", "textRole": "body", "x": 1114, "y": 551, "w": 610, "h": 92, "text": "The latest state survives; the reason a choice changed does not.", "fontSize": 18, "fontWeight": 400, "lineHeight": 1.25, "color": "666666" },
        { "id": "right-3-label", "type": "text", "textRole": "label", "x": 1114, "y": 690, "w": 280, "h": 34, "text": "03 / AUTHORITY", "fontSize": 16, "fontWeight": 600, "color": "1A1A1A" },
        { "id": "right-3-copy", "type": "text", "textRole": "body", "x": 1114, "y": 736, "w": 610, "h": 92, "text": "A recommendation and an approved action look indistinguishable.", "fontSize": 18, "fontWeight": 400, "lineHeight": 1.25, "color": "666666" }
      ]
    },
    {
      "id": "leverage",
      "title": "One context layer removes duplicate work",
      "layout": "data-hero",
      "role": "data",
      "intent": "Use one illustrative metric to show the leverage of shared context.",
