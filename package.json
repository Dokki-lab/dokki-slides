{
  "name": "dokki-slides",
  "version": "1.1.3",
  "description": "Open-source AI presentation skill for Dokki, Claude Code, Codex and OpenClaw. Create interactive web slides and export editable PPTX.",
  "type": "module",
  "license": "MIT-0",
  "bin": {
    "dokki-slides": "./dokki-slides/scripts/dokki-slides.mjs"
  },
  "scripts": {
    "test": "node --test",
    "validate:example": "node dokki-slides/scripts/dokki-slides.mjs check examples/angel-round/deck.json",
    "build:example": "node dokki-slides/scripts/dokki-slides.mjs package examples/angel-round/deck.json --out-dir dist/angel-round"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "ai-presentation",
    "agent-skills",
    "claude-code",
    "codex",
    "dokki",
    "html-slides",
    "openclaw",
    "powerpoint",
    "pptx",
    "presentation"
  ]
}
