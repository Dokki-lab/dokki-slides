{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Dokki-lab/dokki-slides/blob/main/schemas/presentation.schema.json",
  "title": "Dokki Slides presentation",
  "type": "object",
  "required": ["schemaVersion", "deckRevision", "title", "locale", "theme", "slides"],
  "properties": {
    "schemaVersion": { "const": "dokki-slides@1" },
    "deckRevision": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "locale": { "type": "string", "minLength": 2 },
    "theme": {
      "type": "object",
      "required": ["background", "surface", "text", "muted", "accent", "fontFamily", "fontFamilyCjk"],
      "additionalProperties": false,
      "properties": {
        "background": { "type": "string" },
        "surface": { "type": "string" },
        "text": { "type": "string" },
        "muted": { "type": "string" },
        "accent": { "type": "string" },
        "fontFamily": { "type": "string" },
        "fontFamilyCjk": { "type": "string" }
      }
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "elements"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string" },
          "notes": { "type": "string" },
          "background": { "type": "string" },
          "elements": { "type": "array" }
        }
      }
    }
  }
}

