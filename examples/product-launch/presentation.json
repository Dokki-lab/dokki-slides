        { "id": "kpi-label", "type": "text", "textRole": "lead", "x": 125, "y": 520, "w": 600, "h": 140, "text": "fewer context handoffs\nin an illustrative workflow", "fontSize": 24, "fontWeight": 400, "lineHeight": 1.25, "color": "666666" },
        { "id": "baseline", "type": "text", "textRole": "label", "x": 830, "y": 330, "w": 380, "h": 36, "text": "CONTEXT RETAINED", "fontSize": 16, "fontWeight": 600, "color": "1A1A1A" },
