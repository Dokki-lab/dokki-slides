{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Dokki-lab/dokki-slides/blob/main/schemas/presentation.schema.json",
  "title": "Dokki Slides presentation",
  "type": "object",
  "required": ["schemaVersion", "deckRevision", "title", "locale", "theme", "slides"],
  "properties": {
    "schemaVersion": { "const": "dokki-slides@1" },
    "deckRevision": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "locale": { "type": "string", "minLength": 2 },
    "theme": {
      "type": "object",
      "required": ["background", "surface", "text", "muted", "accent", "fontFamily", "fontFamilyCjk"],
      "additionalProperties": false,
      "properties": {
        "style": { "enum": ["dokki-editorial", "custom"] },
        "background": { "$ref": "#/$defs/color" },
        "surface": { "$ref": "#/$defs/color" },
        "text": { "$ref": "#/$defs/color" },
        "muted": { "$ref": "#/$defs/color" },
        "accent": { "$ref": "#/$defs/color" },
        "line": { "$ref": "#/$defs/color" },
        "dark": { "$ref": "#/$defs/color" },
        "accentOn": { "$ref": "#/$defs/color" },
        "fontFamily": { "type": "string", "minLength": 1 },
        "fontFamilyCjk": { "type": "string", "minLength": 1 }
      }
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "elements"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string" },
          "notes": { "type": "string" },
          "background": { "$ref": "#/$defs/color" },
          "layout": { "enum": ["cover-signal", "statement", "section", "split", "data-hero", "comparison", "timeline", "process", "architecture", "chart-ledger", "image-hero", "matrix", "closing-split"] },
          "role": { "enum": ["cover", "section", "statement", "content", "data", "closing"] },
          "intent": { "type": "string", "minLength": 1 },
          "elements": { "type": "array", "items": { "$ref": "#/$defs/element" } }
        }
      }
    }
  },
  "$defs": {
    "color": { "type": "string", "pattern": "^#?[0-9A-Fa-f]{6}$" },
    "element": {
      "type": "object",
      "required": ["id", "type", "x", "y", "w", "h"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "enum": ["text", "shape", "image", "table", "chart", "html"] },
        "x": { "type": "number" }, "y": { "type": "number" }, "w": { "type": "number", "exclusiveMinimum": 0 }, "h": { "type": "number", "exclusiveMinimum": 0 },
        "z": { "type": "number" }, "opacity": { "type": "number", "minimum": 0, "maximum": 1 }, "rotation": { "type": "number" },
        "primary": { "type": "boolean" }, "decorative": { "type": "boolean" }, "overlapGroup": { "type": "string" },
        "textRole": { "enum": ["display", "title", "subtitle", "lead", "body", "label", "meta", "kpi", "caption", "footnote"] }
      }
    }
  }
}
