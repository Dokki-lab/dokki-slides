        { "id": "s1b", "type": "text", "textRole": "body", "x": 120, "y": 570, "w": 300, "h": 140, "text": "Bind the goal to its source and owner.", "fontSize": 18, "fontWeight": 400, "align": "center", "lineHeight": 1.25, "color": "666666" },
        { "id": "s2", "type": "text", "textRole": "label", "x": 570, "y": 350, "w": 300, "h": 36, "text": "02 / DECIDE", "fontSize": 16, "fontWeight": 600, "align": "center", "color": "1A1A1A" },
        { "id": "s2b", "type": "text", "textRole": "body", "x": 570, "y": 570, "w": 300, "h": 140, "text": "Preserve alternatives, evidence, and authority.", "fontSize": 18, "fontWeight": 400, "align": "center", "lineHeight": 1.25, "color": "666666" },
        { "id": "s3", "type": "text", "textRole": "label", "x": 1020, "y": 350, "w": 300, "h": 36, "text": "03 / DELEGATE", "fontSize": 16, "fontWeight": 600, "align": "center", "color": "F50132" },
        { "id": "s3b", "type": "text", "textRole": "body", "x": 1020, "y": 570, "w": 300, "h": 140, "text": "Give agents a bounded, inspectable action.", "fontSize": 18, "fontWeight": 400, "align": "center", "lineHeight": 1.25, "color": "666666" },
        { "id": "s4", "type": "text", "textRole": "label", "x": 1470, "y": 350, "w": 300, "h": 36, "text": "04 / VERIFY", "fontSize": 16, "fontWeight": 600, "align": "center", "color": "1A1A1A" },
        { "id": "s4b", "type": "text", "textRole": "body", "x": 1470, "y": 570, "w": 300, "h": 140, "text": "Return proof to the same operating memory.", "fontSize": 18, "fontWeight": 400, "align": "center", "lineHeight": 1.25, "color": "666666" }
      ]
    },
