      "intent": "Contrast a tool-centric workflow with an intent-centric Dokki workflow.",
      "notes": "Read across each row. Emphasize that governance stays visible.",
      "elements": [
        { "id": "title", "type": "text", "textRole": "title", "primary": true, "x": 120, "y": 150, "w": 1250, "h": 86, "text": "The operating model changes", "fontSize": 35, "fontWeight": 500, "color": "1A1A1A" },
