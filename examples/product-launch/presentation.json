      "elements": [
        { "id": "title", "type": "text", "textRole": "title", "primary": true, "x": 120, "y": 150, "w": 1350, "h": 86, "text": "Intent becomes a verifiable loop", "fontSize": 35, "fontWeight": 500, "color": "1A1A1A" },
