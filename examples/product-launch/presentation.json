        { "id": "l3-label", "type": "text", "textRole": "label", "x": 160, "y": 680, "w": 300, "h": 34, "text": "03 / ARTIFACTS", "fontSize": 16, "fontWeight": 600, "color": "FFFFFF" },
        { "id": "l3-copy", "type": "text", "textRole": "lead", "x": 690, "y": 672, "w": 980, "h": 70, "text": "Documents · data · slides · actions", "fontSize": 24, "fontWeight": 500, "color": "FFFFFF" }
      ]
